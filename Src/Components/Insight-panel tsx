import React from 'react'

interface Insight {
  type: 'Calculated' | 'Heuristic' | 'Prediction'
  text: string
}

interface InsightPanelProps {
  insights: Insight[]
}

const InsightPanel: React.FC<InsightPanelProps> = ({ insights }) => {
  if (!insights || insights.length === 0) {
    return (
      <div className="empty-state small">
        <p>No insights available yet. Upload data to generate insights.</p>
      </div>
    )
  }

  return (
    <div className="insight-panel">
      <h2 className="page-title">Key Insights</h2>
      
      <div className="insights-list">
        {insights.map((insight, index) => (
          <div key={index} className="insight-item">
            <div className={`insight-type ${insight.type.toLowerCase()}`}>
              {insight.type}
            </div>
            <div className="insight-text">{insight.text}</div>
          </div>
        ))}
      </div>
    </div>
  )
}

export default InsightPanel
